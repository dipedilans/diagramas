    %% Hipótese 3 — SQL_Normalizado_2.sql
    %% Padrão: Igual a H2 mas com refinamentos — D_Education sem campo Education numérico,
    %% F_Satisfaction sem FK explícito, F_Performance com DatePerformanceReview, moeda em €
    %% Fonte de dados inclui tabela PingPongSurvey (survey pós-intervenção)

    D_Department ||--o{ D_Employee : "DepartmentID"
    D_Education ||--o{ D_Employee : "EducationID"
    D_JobRole ||--o{ D_Employee : "JobRoleID"

    D_Department ||--o{ F_Performance : "DepartmentID (denorm)"
    D_Department ||--o{ F_Employee_History : "DepartmentID (denorm)"
    D_JobRole ||--o{ F_Performance : "JobRoleID (denorm)"
    D_JobRole ||--o{ F_Employee_History : "JobRoleID (denorm)"

    D_Employee ||--o{ F_Satisfaction : "EmployeeID (sem FK explícito)"
    D_Employee ||--o{ F_Performance : "EmployeeID"
    D_Employee ||--o{ F_Employee_History : "EmployeeID"

    D_Department {
        int DepartmentID PK
        varchar Department UK
    }

    D_JobRole {
        int JobRoleID PK
        varchar JobRole
        int JobLevel
        varchar JobLevelLabel "COMPUTED PERSISTED"
    }

    D_Education {
        int EducationID PK
        varchar EducationField
        varchar Education_Level
    }

    D_Employee {
        int EmployeeID PK
        int Age
        varchar Attrition
        int DepartmentID FK
        int DistanceFromHome
        int EducationID FK
        varchar Gender
        varchar Marital_Status
        varchar BusinessTravel
        varchar Overtime
        int JobRoleID FK
        int NumCompaniesWorked
        int TotalWorkingYears
        int YearsAtCompany
        int YearsInCurrentRole
        int YearsSinceLastPromotion
        int YearsWithCurrManager
        int TrainingTimesLastYear
        varchar Age_Group "COMPUTED PERSISTED"
        varchar Distance_Category "COMPUTED PERSISTED"
        varchar Tenure_Group "COMPUTED PERSISTED"
        varchar Experience_Level "COMPUTED PERSISTED"
        varchar Training_Category "COMPUTED PERSISTED"
        varchar Promotion_Status "COMPUTED PERSISTED"
        int Attrition_Binary "COMPUTED PERSISTED"
        int Overtime_Binary "COMPUTED PERSISTED"
        varchar BusinessTravel_Label "COMPUTED PERSISTED"
    }

    F_Satisfaction {
        int SatisfactionID PK
        int EmployeeID
        date Inquiry_Date
        int Environment_Satisfaction
        int Job_Satisfaction
        int Job_Involvement
        int Relationship_Satisfaction
        int Work_Life_Balance
        varchar Environment_Satisfaction_Label "COMPUTED PERSISTED"
        varchar Job_Satisfaction_Label "COMPUTED PERSISTED"
        varchar Job_Involvement_Label "COMPUTED PERSISTED"
        varchar Relationship_Satisfaction_Label "COMPUTED PERSISTED"
        varchar Work_Life_Balance_Label "COMPUTED PERSISTED"
    }

    F_Performance {
        int PerformanceID PK
        int EmployeeID FK
        date DatePerformanceReview
        int Performance_Rating
        int DepartmentID FK
        int JobRoleID FK
        varchar Performance_Rating_Label "COMPUTED PERSISTED"
    }

    F_Employee_History {
        int HistoryID PK
        int EmployeeID FK
        int JobRoleID FK
        int DepartmentID FK
        date Review_Date
        int DailyRate
        int HourlyRate
        int MonthlyIncome
        int MonthlyRate
        int StockOptionLevel
        int SalaryHike
        varchar Salary_Band "COMPUTED PERSISTED (€)"
        varchar Stock_Option_Category "COMPUTED PERSISTED"
    }
