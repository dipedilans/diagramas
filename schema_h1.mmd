erDiagram
    %% Hipótese 1 — hipotese_modelo.sql
    %% Padrão: F_Employees como hub central + tabelas de extensão 1:1 + 3 dimensões
    %% Nota: as tabelas F_* são extensões do hub, não factos aditivos tradicionais

    D_Department ||--o{ F_Employees : "DepartmentID"
    D_JobRoles ||--o{ F_Employees : "JobRoleID"
    D_Education ||--o{ F_Employees : "EducationID"

    F_Employees ||--|| F_Compensation : "EmployeeNumber (1:1)"
    F_Employees ||--|| F_Satisfaction : "EmployeeNumber (1:1)"
    F_Employees ||--|| F_Performance : "EmployeeNumber (1:1)"
    F_Employees ||--|| F_EmployeeHistory : "EmployeeNumber (1:1)"
    F_Employees ||--|| F_JobCondition : "EmployeeNumber (1:1)"

    D_Department {
        int DepartmentID PK
        varchar Department UK
    }

    D_JobRoles {
        int JobRoleID PK
        varchar JobRole
        int JobLevel
    }

    D_Education {
        int EducationID PK
        int Education
        varchar EducationField
        varchar EducationLevel
    }

    F_Employees {
        int EmployeeNumber PK
        int Age
        varchar Gender
        varchar MaritalStatus
        int DistanceFromHome
        varchar Attrition
        int DepartmentID FK
        int JobRoleID FK
        int EducationID FK
        varchar AgeGroup
        varchar Generation
        varchar DistanceCategory
        int AttritionBinary
    }

    F_Compensation {
        int EmployeeNumber PK
        int MonthlyIncome
        int MonthlyRate
        int DailyRate
        int HourlyRate
        varchar SalaryBand
    }

    F_Satisfaction {
        int EmployeeNumber PK
        int JobSatisfaction
        int EnvironmentSatisfaction
        int RelationshipSatisfaction
        int WorkLifeBalance
        varchar JobSatisfactionLabel
        varchar EnvironmentSatisfactionLabel
        varchar RelationshipSatisfactionLabel
        varchar WorkLifeBalanceLabel
    }

    F_Performance {
        int EmployeeNumber PK
        int PerformanceRating
        int JobInvolvement
        int PercentSalaryHike
        int StockOptionLevel
        int TrainingTimesLastYear
        int YearsAtCompany
        int YearsInCurrentRole
        int YearsSinceLastPromotion
        int YearsWithCurrManager
        varchar PerformanceRatingLabel
        varchar TenureGroup
        varchar StockOptionCategory
    }

    F_EmployeeHistory {
        int EmployeeNumber PK
        int NumCompaniesWorked
        int TotalWorkingYears
        varchar ExperienceLevel
    }

    F_JobCondition {
        int EmployeeNumber PK
        varchar BusinessTravel
        varchar OverTime
        varchar BusinessTravelLabel
        int OvertimeBinary
    }

    Staging_HR_Data {
        int Age
        varchar Attrition
        varchar BusinessTravel
        int DailyRate
        varchar Department
        int DistanceFromHome
        int Education
        varchar EducationField
        int EmployeeCount
        int EmployeeNumber
        int EnvironmentSatisfaction
        varchar Gender
        int HourlyRate
        int JobInvolvement
        varchar JobLevel
        varchar JobRole
        int JobSatisfaction
        varchar MaritalStatus
        int MonthlyIncome
        int MonthlyRate
        int NumCompaniesWorked
        varchar Over18
        varchar OverTime
        int PercentSalaryHike
        int PerformanceRating
        int RelationshipSatisfaction
        int StandardHours
        int StockOptionLevel
        int TotalWorkingYears
        int TrainingTimesLastYear
        int WorkLifeBalance
        int YearsAtCompany
        int YearsInCurrentRole
        int YearsSinceLastPromotion
        int YearsWithCurrManager
    }
